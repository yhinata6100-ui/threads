# ローカルで動作確認する場合にコピーして .env として使う。
# 実運用（GitHub Actions）ではこの値は使わず、リポジトリの
# Settings > Secrets and variables > Actions に同じ名前で登録する。
# .env は絶対にコミットしないこと（.gitignore 済み）。

# Notion インテグレーションのシークレットキー
NOTION_API_KEY=

# setup_notion.py 実行後に払い出される投稿管理DB / リサーチDBのID
NOTION_DATABASE_ID=
NOTION_RESEARCH_DB_ID=

# DBを作成する親ページのURLまたはID（setup_notion.py 実行時のみ使用）
NOTION_PARENT_PAGE_ID=

# Meta開発者アプリで発行した Threads の長期アクセストークン
# 権限: threads_basic, threads_content_publish, threads_manage_insights
THREADS_ACCESS_TOKEN=

# refresh_token.py がGitHub Secretsを自動更新する場合のみ必要
# Settings > Secrets and variables > Actions の書き換え権限を持つ
# Fine-grained PAT（Contents: Read/Write, Secrets: Read/Write）
GH_ADMIN_TOKEN=
